<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Aqua Serena</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AquaSerena.styles.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-md bg-dark" data-bs-theme="dark">
        <div class="container">
            <a class="navbar-brand" href="/">Aqua Serena</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menuPrincipal">
                <div class="navbar-nav ms-auto">
                    <a class="nav-link" href="/#inicio">Inicio</a>
                    <a class="nav-link" href="/#servicios">Servicios</a>
                    <a class="nav-link" href="/#horarios">Horarios</a>
                    <a class="nav-link" asp-controller="Reserva" asp-action="Index">Reservas</a>
                </div>
            </div>
        </div>
    </nav>

    @RenderBody()

    <footer class="pie-pagina text-center py-3">
        <p class="mb-0">Aqua Serena | Centro de bienestar</p>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


