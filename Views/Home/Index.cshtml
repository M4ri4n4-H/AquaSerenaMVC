@{
    ViewData["Title"] = "Inicio";
}

<header id="inicio" class="encabezado-principal text-center py-5">
    <div class="container">
        <h1 class="display-4 fw-bold">Aqua Serena</h1>
        <p class="lead mb-0">Un espacio para encontrar calma, equilibrio y bienestar.</p>
    </div>
</header>

<main class="container py-5">
    <div class="alert alert-success" role="alert">
        Regálate un momento para descansar y cuidar de ti.
    </div>

    <section id="bienvenida" class="my-5">
        <h2>Bienvenido a Aqua Serena</h2>
        <p>Un lugar inspirado en la tranquilidad del agua, creado para ayudarte a descansar y cuidar de ti.</p>
        <ul>
            <li>Momentos de relajación</li>
            <li>Actividades para cuidar el cuerpo</li>
            <li>Espacios para despejar la mente</li>
        </ul>
        <img src="https://images.unsplash.com/photo-1545205597-3d9d02c29597?auto=format&fit=crop&w=1200&q=80"
             alt="Persona relajándose en un ambiente de bienestar"
             class="img-fluid rounded-3 mt-3" />
    </section>

    <section id="video" class="my-5">
        <h2>Momento de relajación</h2>
        <p>Te invitamos a disfrutar de una práctica breve para calmar la mente.</p>
        <div class="ratio ratio-16x9" style="max-width: 700px;">
            <iframe src="https://www.youtube.com/embed/v7AYKMP6rOE"
                    title="Video de yoga para principiantes"
                    allowfullscreen></iframe>
        </div>
    </section>
    <section id="servicios" class="my-5">
        <h2 class="text-center mb-4">Nuestros servicios</h2>
        <div class="row g-4">
            <div class="col-12 col-md-4">
                <article class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h3 class="card-title h5">Yoga junto al agua</h3>
                        <p class="card-text">Movimientos suaves y respiración consciente para recuperar el equilibrio.</p>
                    </div>
                </article>
            </div>
            <div class="col-12 col-md-4">
                <article class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h3 class="card-title h5">Meditación guiada</h3>
                        <p class="card-text">Sesiones tranquilas para reducir el estrés y conectar con el momento presente.</p>
                    </div>
                </article>
            </div>
            <div class="col-12 col-md-4">
                <article class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h3 class="card-title h5">Masaje relajante</h3>
                        <p class="card-text">Un espacio de descanso para liberar tensiones y cuidar tu cuerpo.</p>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section class="my-5 p-4 border rounded shadow-sm text-center">
        <h2>Reserva tu espacio</h2>
        <p>Cuéntanos qué actividad te interesa.</p>
        <a asp-controller="Reserva" asp-action="Index" class="btn btn-primary">Ir al formulario</a>
    </section>

    <section id="horarios" class="my-5">
        <h2>Horarios de atención</h2>
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <caption>Actividades disponibles durante la semana</caption>
                <thead class="table-dark">
                    <tr>
                        <th>Hora</th>
                        <th>Lunes</th>
                        <th>Miércoles</th>
                        <th>Viernes</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>08:00</td>
                        <td>Yoga</td>
                        <td>Meditación</td>
                        <td>Yoga</td>
                    </tr>
                    <tr>
                        <td>17:00</td>
                        <td>Masaje</td>
                        <td>Yoga</td>
                        <td>Masaje</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <p class="texto-secundario">Cupos limitados. Reserva con anticipación.</p>
    </section>
</main>




